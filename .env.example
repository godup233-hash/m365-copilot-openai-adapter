# ===== 必填 =====
# Adapter 自己的接入密钥：Sub2API 账户的 API Key 填这个值
ADAPTER_API_KEY=change-me-to-a-long-random-string
# Entra ID 应用注册的 Application (client) ID（公共客户端）
AZURE_CLIENT_ID=

# ===== 可选 =====
# 租户 ID；多租户应用注册用 organizations，单租户填具体 tenant id
AZURE_TENANT_ID=organizations
# 监听地址/端口（默认只绑回环；与 Sub2API 同 Docker 网络时改 0.0.0.0）
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# Microsoft Graph 基址（beta；Chat API 仅在 beta 提供）
GRAPH_BASE_URL=https://graph.microsoft.com/beta
# Token Cache 落盘位置（容器内默认 /data/token_cache.bin，用 volume 持久化）
TOKEN_CACHE_PATH=~/.config/m365-adapter/token_cache.bin
# 对客户端暴露的模型别名（仅别名，不代表可切换微软内部模型）
MODEL_ALIAS=m365-copilot-chat
# 发给上游的 locationHint 时区
DEFAULT_TIMEZONE=Asia/Shanghai
# 会话映射本地 TTL（秒），默认 24h
SESSION_TTL_SECONDS=86400
# 会话失效恢复策略：off=报错让客户端重开；auto_new=自动新建会话并注入历史（有损）
SESSION_RECOVERY=off
# 新会话首轮是否把 messages 历史注入 additionalContext
INJECT_HISTORY_ON_FIRST_TURN=true
# 上游超时/重试/并发
REQUEST_TIMEOUT_SECONDS=120
STREAM_TIMEOUT_SECONDS=300
UPSTREAM_MAX_RETRIES=3
UPSTREAM_CONCURRENCY=4
# 单请求体大小上限（字节）
MAX_REQUEST_BYTES=1048576
